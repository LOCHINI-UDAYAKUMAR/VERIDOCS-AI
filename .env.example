# ─── VeriDocs AI — Environment Variables ────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# ── Application ──────────────────────────────────────────────────────────────

# JWT signing secret — CHANGE THIS in production to a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT signing secret.
# Development (npm run dev): optional — a dev default is used if unset.
# Production (npm run build && npm start, or NODE_ENV=production): REQUIRED.
#   The app will refuse to sign or verify tokens without a real secret set
#   here — this is intentional (a previous version silently used a
#   publicly-known default in production, which would let anyone forge
#   valid login tokens for your deployment).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Public base URL of your deployment, used to build QR verification links.
# Required for production; without it, QR codes may be generated with an
# incorrect host if the app sits behind a proxy/load balancer.
# Example: https://veridocs.yourcompany.com
APP_BASE_URL=

# ── Blockchain ───────────────────────────────────────────────────────────────
# Leave these blank to use the default SQLite hash-chain ledger (works out
# of the box, no wallet or RPC needed). Set them to switch to the real
# Ethereum contract (VeriDocs.sol).

# Set to "ethereum" to use the real contract; leave blank for SQLite hash-chain
BLOCKCHAIN_PROVIDER=

# RPC endpoint for your chosen network:
#   Local Hardhat node:  http://127.0.0.1:8545
#   Sepolia testnet:     https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
#   Polygon mainnet:     https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
BLOCKCHAIN_RPC_URL=

# Private key of the wallet that will pay gas and seal documents on-chain.
# This wallet must be funded with ETH/MATIC before deploying or sealing.
# For local development, Hardhat pre-funds test accounts automatically
# (use Account #0's private key from `npx hardhat node` output).
# NEVER commit this key — it controls your on-chain sealer role.
BLOCKCHAIN_PRIVATE_KEY=

# Deployed contract address — set automatically by npm run deploy:*
# or paste manually from a previous deployment.
CONTRACT_ADDRESS=

# Optional: use a separate funded wallet as sealer (recommended for production)
# instead of the deployer wallet. If blank, deployer = sealer.
BLOCKCHAIN_SEALER_ADDRESS=

# ── Block explorer verification ───────────────────────────────────────────────
# Optional — needed only for `npx hardhat verify` to publish source on Etherscan.
ETHERSCAN_API_KEY=
POLYGONSCAN_API_KEY=

# ── AI Verification Assistant (optional) ─────────────────────────────────────
# Add one of these to upgrade the AI assistant from rule-based explanations
# to real LLM-generated natural language. If blank, the rule-based fallback
# is used automatically (lib/assistant.js).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
